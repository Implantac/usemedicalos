{
  "manifest_version": 3,
  "name": "USE Medical — Portal Capture",
  "version": "0.1.0",
  "description": "Captura RFQs de portais hospitalares (Bionexo, Apoio Cotação) e envia para o USE Medical Commercial OS.",
  "permissions": ["activeTab", "storage", "scripting", "notifications"],
  "host_permissions": [
    "https://*.bionexo.com.br/*",
    "https://*.apoiocotacao.com.br/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.bionexo.com.br/*",
        "https://*.apoiocotacao.com.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
